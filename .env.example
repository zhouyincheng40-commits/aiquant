# Copy to .env and fill locally. NEVER commit .env.
# On cloud: export these in the shell / systemd / container env.

# Workspace root (required on non-Windows / cloud)
AIQUANT_HOME=/workspace/aiquant

# Python interpreters
AIQUANT_PYTHON=python3
# Optional live/CTP env (leave empty on cloud unless you need it)
# AIQUANT_PYTHON_LIVE=

# HTTP proxies (only if the cloud host needs them for Polymarket / OKX / Binance)
# QUANT_MCP_PROXY=http://127.0.0.1:7890
# POLY_PROXY=http://127.0.0.1:7890
# OKX_PROXY=http://127.0.0.1:7890
# AIQUANT_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=
# HTTP_PROXY=

# Optional data-vendor tokens (leave blank if unused)
# TUSHARE_TOKEN=
# OPENAI_API_KEY=

# CTP / SimNow — NEVER put real values in git; only in private cloud secrets
# CTP_USER_ID=
# CTP_PASSWORD=
# CTP_BROKER_ID=
# CTP_AUTH_CODE=
# CTP_APP_ID=
# CTP_TD_ADDRESS=
# CTP_MD_ADDRESS=
